          <mxGeometry x="300" y="520" width="300" height="55" as="geometry" />
        </mxCell>

        <mxCell id="gunicorn" value="Gunicorn + Uvicorn Workers&lt;br&gt;(127.0.0.1:8000, localhost only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="595" width="300" height="55" as="geometry" />
        </mxCell>

        <mxCell id="fastapi" value="FastAPI App (systemd service)&lt;br&gt;JWT Auth &#183; RBAC (Viewer/Admin)&lt;br&gt;Recursive CTE tree queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="670" width="300" height="75" as="geometry" />
        </mxCell>

        <!-- rds-sg Container -->
        <mxCell id="rdssgBox" value="Security Group: rds-sg&lt;br&gt;Inbound: 5432 (from ec2-sg only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
