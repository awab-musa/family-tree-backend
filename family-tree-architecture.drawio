          <mxGeometry x="500" y="160" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- AWS Region Container -->
        <mxCell id="regionBox" value="AWS Cloud &#8212; Region (e.g. us-east-1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;dashed=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="200" y="350" width="1260" height="560" as="geometry" />
        </mxCell>

        <!-- VPC Container -->
        <mxCell id="vpcBox" value="Default VPC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7B7B7B;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="230" y="390" width="900" height="480" as="geometry" />
        </mxCell>

        <!-- ec2-sg Container -->
        <mxCell id="ec2sgBox" value="Security Group: ec2-sg&lt;br&gt;Inbound: 22 (My IP), 80 (Anywhere)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="440" width="380" height="400" as="geometry" />
        </mxCell>

        <!-- EC2 instance box -->
        <mxCell id="ec2box" value="EC2 t2.micro &#8212; Ubuntu 22.04 LTS&lt;br&gt;(family-tree-backend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="480" width="340" height="330" as="geometry" />
        </mxCell>

