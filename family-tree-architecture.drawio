        <mxCell id="e2" value="/* (static assets)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="cloudfront" target="s3frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="/api/* requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="cloudfront" target="nginx">
