          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" value="asyncpg :5432&#10;(recursive CTE queries)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="fastapi" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

