        </mxCell>

        <!-- S3 Media (outside VPC, still in region) -->
        <mxCell id="s3media" value="S3 Bucket&lt;br&gt;family-tree-media&lt;br&gt;(Photos / Documents)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
