# ---- App ----
ENV=development

# ---- Database (Amazon RDS - PostgreSQL) ----
# Local dev example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/family_tree
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@YOUR_RDS_ENDPOINT:5432/family_tree

# ---- JWT ----
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---- AWS / S3 ----
AWS_REGION=us-east-1
S3_BUCKET_NAME=family-tree-media-bucket
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# ---- CORS ----
# Comma-separated list is NOT supported directly by pydantic-settings list parsing
# from .env; for local dev this is fine as JSON array syntax:
CORS_ORIGINS=["http://localhost:3000"]
